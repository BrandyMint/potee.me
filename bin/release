#!/usr/bin/env bash
# Cut a release: bump VERSION (semver), commit, tag vX.Y.Z, push and create the
# GitHub release with the commits since the previous tag as notes.
#   bin/release [patch|minor|major]   (patch by default)
# Then deploy it with bin/deploy.
set -euo pipefail
cd "$(dirname "$0")/.."

level="${1:-patch}"
case "$level" in patch|minor|major) ;; *) echo "usage: bin/release [patch|minor|major]" >&2; exit 1 ;; esac

branch="$(git rev-parse --abbrev-ref HEAD)"
[ "$branch" = develop ] || { echo "Release from develop (now on $branch)" >&2; exit 1; }
git diff --quiet && git diff --cached --quiet || { echo "Commit or stash changes first" >&2; exit 1; }
git pull --rebase --quiet

IFS=. read -r major minor patch < VERSION
case "$level" in
  major) major=$((major + 1)); minor=0; patch=0 ;;
  minor) minor=$((minor + 1)); patch=0 ;;
  patch) patch=$((patch + 1)) ;;
esac
version="$major.$minor.$patch"
previous="$(git describe --tags --abbrev=0 --match 'v[0-9]*.[0-9]*.[0-9]*' 2>/dev/null || true)"

echo "$version" > VERSION
git commit --quiet -m "Release v$version" VERSION
git tag -a "v$version" -m "v$version"
git push --quiet --atomic origin develop "v$version"

notes="$(git log --no-merges --format='- %s' ${previous:+"$previous"..}"v$version^")"
gh release create "v$version" --title "v$version" --notes "${notes:-Release v$version}"
echo "Released v$version. Deploy: bin/deploy"
