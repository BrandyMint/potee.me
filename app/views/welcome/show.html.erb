<% content_for :body_class, "welcome-page" %>
<% content_for :head do %>
  <%= vite_stylesheet_tag "pages.css" %>
<% end %>

<main class="welcome">
  <%= link_to board_path, class: "welcome-logo" do %>
    <%= image_tag "logo_potee.png", alt: "Potee", width: 170, height: 242 %>
  <% end %>
  <div class="welcome-text">
    <h1><%= t("welcome.headline") %></h1>
    <p><%= t("welcome.lead") %></p>
    <%= link_to t("welcome.get_started"), board_path, class: "welcome-start" %>
    <%= link_to t("welcome.log_in"), login_path, class: "welcome-login" %>
  </div>
</main>
