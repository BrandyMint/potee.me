<% content_for :body_class, "welcome-page" %>
<% content_for :head do %>
  <%= vite_stylesheet_tag "welcome.css" %>
<% end %>

<main class="welcome">
  <%= link_to board_path, class: "welcome-logo" do %>
    <%= image_tag "logo_potee.png", alt: "Potee", width: 170, height: 242 %>
  <% end %>
  <div class="welcome-text">
    <h1>New way of planning.</h1>
    <p>Now you know what is the next step in your projects.</p>
    <%= link_to "Get started", board_path, class: "welcome-start" %>
  </div>
</main>
