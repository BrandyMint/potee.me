<% content_for :body_class, "auth-page" %>
<% content_for :head do %>
  <%= vite_stylesheet_tag "pages.css" %>
<% end %>
<% content_for :page do %>
  <main class="auth <%= yield :auth_class %>">
    <%# Back to the visitor's board when there is one, otherwise the landing. %>
    <%= link_to(session_user ? board_path : root_path, class: "auth-logo") do %>
      <%= image_tag "logo.png", alt: "Potee" %>
    <% end %>
    <%= render "shared/flash" %>
    <%= yield %>
  </main>
<% end %>
<%= render template: "layouts/application" %>
