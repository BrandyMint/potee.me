<% content_for :title, "New password — Potee" %>
<h1>New password</h1>
<p class="lead">For <%= @user.email %></p>
<%= form_with url: password_path(params[:token]), method: :patch do |form| %>
  <%= form.label :password do %>New password (8+ characters)<%= form.password_field :password, required: true, minlength: 8, maxlength: 72, autofocus: true, autocomplete: "new-password" %><% end %>
  <%= form.button "Save password" %>
<% end %>
