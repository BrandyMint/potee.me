<% content_for :title, "Reset password — Potee" %>
<h1>Reset password</h1>
<p class="lead">We will email you a link to set a new password.</p>
<%= form_with url: passwords_path do |form| %>
  <%= form.label :email do %>Email<%= form.email_field :email, required: true, autofocus: true, autocomplete: "username" %><% end %>
  <%= form.button "Send the link" %>
<% end %>
<div class="links">
  <%= link_to "Back to log in", login_path %>
</div>
