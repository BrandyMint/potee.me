<%# Yandex Metrika without Webvisor, click map or link tracking. The hit carries
    the page path and only UTM tags valid by the fleet standard attribution/v1
    (corp-sales/marketing/attribution.md); the referrer goes without its query.
    Elements with data-metrika-goal report that goal on click. %>
<script>
  (function(m,e,t,r,i,k,a){m[i]=m[i]||function(){(m[i].a=m[i].a||[]).push(arguments)};
  m[i].l=1*new Date();k=e.createElement(t),a=e.getElementsByTagName(t)[0];
  k.async=1;k.src=r;a.parentNode.insertBefore(k,a)})(window,document,"script","https://mc.yandex.ru/metrika/tag.js","ym");
  (function(w,d,id){
    var url=new URL(w.location.href),utm=new URLSearchParams();
    ["utm_source","utm_medium","utm_campaign","utm_content","utm_term"].forEach(function(key){
      var value=(url.searchParams.get(key)||"").trim().toLowerCase();
      if(/^[a-z0-9][a-z0-9_-]{0,49}$/.test(value))utm.set(key,value);
    });
    var page=url.origin+url.pathname+(utm.toString()?"?"+utm.toString():""),referer="";
    try{if(d.referrer){var source=new URL(d.referrer);referer=source.origin+source.pathname;}}catch(error){}
    w.ym(id,"init",{defer:true,clickmap:false,trackLinks:false,webvisor:false,accurateTrackBounce:true});
    w.ym(id,"hit",page,{referer:referer});
    d.addEventListener("click",function(event){
      var target=event.target&&event.target.closest?event.target.closest("[data-metrika-goal]"):null;
      if(target)w.ym(id,"reachGoal",target.getAttribute("data-metrika-goal"));
    },true);
  })(window,document,<%= metrika_counter %>);
</script>
