<% content_for :title, "Sign up — Potee" %>
<h1>Save your board</h1>
<p class="lead">Your projects stay with you on any device.</p>
<%= form_with url: signup_path do |form| %>
  <%= form.label :email do %>Email<%= form.email_field :email, value: @email, required: true, autofocus: true, autocomplete: "username" %><% end %>
  <%= form.label :password do %>Password (8+ characters)<%= form.password_field :password, required: true, minlength: 8, maxlength: 72, autocomplete: "new-password" %><% end %>
  <%= form.button "Sign up" %>
<% end %>
<div class="links">
  <%= link_to "Already registered? Log in", login_path %>
</div>
